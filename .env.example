# --- HTTP Server -----------------------------------------------------------------------

SERVER_BIND_ADDR=0.0.0.0:8080
SERVER_BASE_PATH=/
SERVER_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=30s

# --- Logger ----------------------------------------------------------------------------

LOGGER_FORMAT=text
LOGGER_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------------------

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres
POSTGRES_SSLMODE=disable
POSTGRES_AUTO_MIGRATE=true

# --- Model Provider --------------------------------------------------------------------

PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
PROVIDER_API_KEY_OPENCODE=
PROVIDER_MODEL=deepseek-v4-flash
PROVIDER_REASONING_EFFORT=medium

# --- Telegram --------------------------------------------------------------------------

TELEGRAM_API_KEY=
TELEGRAM_CHANNEL_ID=

# --- Tavily ----------------------------------------------------------------------------

TAVILY_API_KEY=
