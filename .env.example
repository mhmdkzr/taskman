# --- NATS ------------------------------------------------------------------------------

NATS_URL=nats://127.0.0.1:4222

# --- HTTP Server -----------------------------------------------------------------------

SERVER_BIND_ADDR=127.0.0.1:8080
SERVER_BASE_PATH=/
SERVER_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=30s

# --- Logger ----------------------------------------------------------------------------

LOGGER_FORMAT=text
LOGGER_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------------------

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres
POSTGRES_SSLMODE=disable
POSTGRES_AUTO_MIGRATE=true

# --- Temporal --------------------------------------------------------------------------

TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=127.0.0.1:7233

# --- Postgres Exporter -----------------------------------------------------------------

DATA_SOURCE_NAME=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# --- Audit Log -------------------------------------------------------------------------

AUDIT_LOG_TIMEOUT=10s

# --- Notifier --------------------------------------------------------------------------

NOTIFIER_ENABLED=false
NOTIFIER_TELEGRAM_BOT_TOKEN=
NOTIFIER_TELEGRAM_CHANNEL_ID=

# --- App / Compose Infra -------------------------------------------------------------

SKIP_ENV_AUTO_LOAD=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
BACKEND_URL=127.0.0.1:8080
POSTGRES_DB=postgres
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_DB=postgres12
TEMPORAL_DB_PORT=5432
TEMPORAL_BIND_ON_IP=0.0.0.0
TEMPORAL_DYNAMIC_CONFIG_PATH=config/dynamicconfig/development-sql.yaml

# --- Zitadel -------------------------------------------------------------------------

ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters # dev only, 32 chars, rotate for prod
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_TLS_ENABLED=false
ZITADEL_DATABASE_POSTGRES_HOST=127.0.0.1
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=postgres
ZITADEL_DATABASE_POSTGRES_USER=postgres
ZITADEL_DATABASE_POSTGRES_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_MAXOPENCONNS=10
ZITADEL_DATABASE_POSTGRES_SSL_MODE=disable
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED=false
ZITADEL_FIRSTINSTANCE_LOGINCLIENTPATPATH=/zitadel/bootstrap/login-client.pat
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_USERNAME=login-client
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_NAME=Automatically Initialized IAM_LOGIN_CLIENT
ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_PAT_EXPIRATIONDATE=2099-01-01T00:00:00Z
# IAM_OWNER machine user, bootstrapped once on first instance init. Its PAT
# is used by scripts/provision-zitadel-bff.sh to create the BFF OIDC app via
# the Management API (the login-client account above cannot: it is scoped to
# login operations only).
ZITADEL_FIRSTINSTANCE_PATPATH=/zitadel/bootstrap/admin-provisioner.pat
ZITADEL_FIRSTINSTANCE_MACHINEKEYPATH=/zitadel/bootstrap/admin-provisioner-key.json
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME=admin-provisioner
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME=Automatically Initialized Admin Provisioner
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINEKEY_TYPE=1
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINEKEY_EXPIRATIONDATE=2099-01-01T00:00:00Z
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE=2099-01-01T00:00:00Z
ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED=true
# Points ZITADEL's Login V2 base URI at our own custom login UI (served by
# `app`/Caddy on :8090) rather than the zitadel-login container, so
# authorization requests never redirect to ZITADEL's hosted UI. Applied at
# first-instance bootstrap here; scripts/provision-zitadel-bff.sh also
# (re)applies it at runtime via the Feature API, which is what actually
# matters for an already-bootstrapped instance.
ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_BASEURI=http://localhost:8090/
ZITADEL_OIDC_DEFAULTLOGINURLV2=http://localhost:8090/login?authRequest=
ZITADEL_OIDC_DEFAULTLOGOUTURLV2=http://localhost:8090/login?post_logout_redirect=
ZITADEL_SAML_DEFAULTLOGINURLV2=http://localhost:8090/login?samlRequest=
ZITADEL_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_BASE_PATH=/ui/v2/login
ZITADEL_SERVICE_USER_TOKEN_FILE=/zitadel/bootstrap/login-client.pat
CUSTOM_REQUEST_HEADERS=Host:localhost,X-Forwarded-Proto:http

# --- TigerBeetle -----------------------------------------------------------------------

TIGERBEETLE_ADDRESS=127.0.0.1:3000
TIGERBEETLE_CLUSTER_ID=0

# --- Zitadel Client (app) --------------------------------------------------------------

ZITADEL_CLIENT_DOMAIN=127.0.0.1:8080
ZITADEL_CLIENT_INSTANCE_HOST=localhost
ZITADEL_CLIENT_INSECURE=true

# --- BFF authentication ---------------------------------------------------------------

# Run scripts/provision-zitadel-bff.sh to create the confidential Web
# application in Zitadel and populate AUTH_CLIENT_ID/AUTH_CLIENT_SECRET below,
# then set AUTH_ENABLED=true.
AUTH_ENABLED=false
AUTH_ISSUER=http://localhost:8080
AUTH_INTERNAL_ADDRESS=zitadel:8080
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URL=http://localhost:8090/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URL=http://localhost:8090/
# Bearer token for internal/auth/loginui's Session/OIDC v2 REST calls. This is
# the same IAM_LOGIN_CLIENT-scoped PAT the zitadel-login container uses
# (ZITADEL_SERVICE_USER_TOKEN_FILE above), read from the shared bootstrap
# volume the `app` service also mounts read-only (see compose.yaml).
AUTH_LOGIN_CLIENT_PAT_PATH=/zitadel/bootstrap/login-client.pat
# Bearer token for registration/password-reset/TOTP-enrollment calls, which
# exceed IAM_LOGIN_CLIENT's scope. Reuses the admin-provisioner PAT (see
# scripts/provision-zitadel-bff.sh) already mounted read-only into `app`.
AUTH_ADMIN_PAT_PATH=/zitadel/bootstrap/admin-provisioner.pat
AUTH_SESSION_LIFETIME=24h
AUTH_SESSION_IDLE_TIMEOUT=8h
AUTH_REFRESH_LEEWAY=1m
AUTH_COOKIE_SECURE=false

# --- Private webhooks -----------------------------------------------------------------

WEBHOOKS_ZITADEL_PATH_SECRET=

# --- SMTP (MailHog) --------------------------------------------------------------------

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=App
SMTP_USERNAME=
SMTP_PASSWORD=
