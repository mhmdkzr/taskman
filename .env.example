# --- NATS ------------------------------------------------------------------------------

NATS_URL=nats://127.0.0.1:4222

# --- HTTP Server -----------------------------------------------------------------------

SERVER_BIND_ADDR=127.0.0.1:8080
SERVER_BASE_PATH=/
SERVER_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=30s

# --- Logger ----------------------------------------------------------------------------

LOGGER_FORMAT=text
LOGGER_LEVEL=info

# --- Agent ----------------------------------------------------------------------------

AGENT_PROVIDER_BASE_URL=
AGENT_PROVIDER_API_KEY=
AGENT_DB_PATH=~/.taskman/taskman.db
AGENT_MODEL=deepseek-v4-flash
AGENT_REASONING_EFFORT=medium
AGENT_MAX_STEPS=100
AGENT_TELEGRAM_API_KEY=
AGENT_TELEGRAM_CHANNEL_ID=

# --- App -------------------------------------------------------------------------------

SKIP_ENV_AUTO_LOAD=true