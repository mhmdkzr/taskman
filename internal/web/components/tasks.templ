package components

import "strconv"

import "github.com/mhmdkzr/loop/internal/agent/sessions"

// taskListPage is the only Tasks-mode view: every task grouped into sections
// by state - tasks needing attention float to the top - each rendered as a
// card that expands in place to its full detail when clicked.
templ taskListPage(tasks []TaskDetailView) {
	<div class="task-list-view" id="task-list">
		if len(tasks) == 0 {
			<div class="empty-state">No tasks yet.</div>
		} else {
			<div class="col task-sections">
				for _, section := range groupTasksByState(tasks) {
					<div class="task-section">
						<div class="task-section-label">{ section.Label } ({ strconv.Itoa(len(section.Tasks)) })</div>
						<div class="task-grid">
							for _, t := range section.Tasks {
								@taskCard(t)
							}
						</div>
					</div>
				}
			</div>
		}
	</div>
}

// taskCard is one task, collapsed to a summary row by default: clicking it
// expands the same card - not a link to a separate page - to show its
// specification, details, and every session dispatched for it inline.
templ taskCard(t TaskDetailView) {
	{{ taskID := t.Task.ID.String() }}
	<div class="task-card" { taskOpenAttrs(taskID, false)... }>
		<button type="button" class="task-card-summary" data-on:click={ taskToggleAction(taskID) }>
			<div class="task-card-top">
				<span class="task-card-def">{ t.Task.Definition }</span>
				@statusPill(string(t.Task.State))
			</div>
			<div class="task-card-bottom">
				if len(t.Task.Labels) > 0 {
					<div class="task-card-labels">
						for _, label := range t.Task.Labels {
							<span class="tag">{ label }</span>
						}
					</div>
				}
				<span class="task-card-meta tabular">
					{ formatTokens(int64(len(t.Sessions))) }
					if len(t.Sessions) == 1 {
						session
					} else {
						sessions
					}
					<span class="task-card-meta-sep">·</span>
					{ formatTokens(taskTotalTokens(t)) } tok
				</span>
				<span class="task-card-chevron" data-class:open={ taskOpenExpr(taskID) }>▸</span>
			</div>
		</button>
		<div class="task-card-detail" data-class:open={ taskOpenExpr(taskID) }>
			<div class="task-card-detail-inner">
				<div>
					<div class="section-label">Specification</div>
					<div class="spec-block md-content">
						@renderMarkdown(t.Task.Specification)
					</div>
				</div>
				<div>
					<div class="detail-facts">
						if provider := modelProvider(t.Task.Model); provider != "" {
							<div class="detail-cell">
								<span class="name">Provider</span>
								<span class="val">{ provider }</span>
							</div>
						}
						<div class="detail-cell">
							<span class="name">Model</span>
							<span class="val">{ t.Task.Model }</span>
						</div>
						if t.Task.ReasoningEffort != "" {
							<div class="detail-cell">
								<span class="name">Thinking</span>
								<span class="val">{ t.Task.ReasoningEffort }</span>
							</div>
						}
					</div>
					<div class="detail-levels">
						@levelCell("Importance", int(t.Task.Importance))
						@levelCell("Urgency", int(t.Task.Urgency))
						@levelCell("Complexity", int(t.Task.Complexity))
						@levelCell("Effort", int(t.Task.Effort))
						@levelCell("Risk", int(t.Task.Risk))
						@levelCell("Autonomy", int(t.Task.Autonomy))
					</div>
					if t.Task.CommitHash != "" || t.Task.Branch != "" {
						<div class="detail-facts" style="margin-bottom:0; margin-top:20px;">
							if t.Task.CommitHash != "" {
								<div class="detail-cell">
									<span class="name">Commit</span>
									<span class="val">{ t.Task.CommitHash }</span>
								</div>
							}
							if t.Task.Branch != "" {
								<div class="detail-cell">
									<span class="name">Branch</span>
									<span class="val">{ t.Task.Branch }</span>
								</div>
							}
						</div>
					}
				</div>
				<div>
					<div class="section-label">Sessions</div>
					if len(t.Sessions) > 0 {
						<div class="session-panels">
							for _, row := range t.Sessions {
								@sessionPanel(row)
							}
						</div>
					} else {
						<div class="section-empty">No sessions dispatched for this task yet.</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// levelCell renders a 1-5 planning level as one cell in the fixed 3-column
// detail-levels grid: a name and its plain-English level (see levelLabel),
// immune to the ragged last row a variable-count wrapping grid would
// otherwise leave.
templ levelCell(name string, level int) {
	<div class="detail-cell">
		<span class="name">{ name }</span>
		<span class="val">{ levelLabel(level) }</span>
	</div>
}

// sessionPanel renders one session linked to a task as a collapsible panel
// with its full turn-by-turn history inline. Its open/closed state lives in
// a Datastar signal (see sessionOpenAttrs) rather than a native <details>
// element's "open" attribute: the task list patches itself on an ambient
// poll (see the data-on-interval in App), and a signal declared with
// __ifmissing survives that - re-rendering the same (initially-closed)
// markup - where a plain HTML attribute would have been reset to closed on
// every tick. The open class (see .session-panel-body in page.templ)
// animates the expand via a max-height transition rather than an abrupt
// display toggle.
templ sessionPanel(row TaskSessionRow) {
	{{ sessionID := row.Session.SessionID.String() }}
	<div class="session-panel" { sessionOpenAttrs(sessionID)... }>
		<div class="session-panel-summary" data-on:click={ sessionToggleAction(sessionID) }>
			<span class="session-row-agent">{ row.Session.AgentName }</span>
			<span class="session-row-meta">
				if row.Detail.ModelName != "" {
					<span>{ row.Detail.ModelName }</span>
				}
				if row.Detail.ReasoningEffort != "" {
					<span>{ row.Detail.ReasoningEffort }</span>
				}
			</span>
			<span class="session-row-tokens tabular">{ formatTokens(row.Session.TotalTokens) } tok</span>
			@statusPill(row.Session.Status)
			<span class="session-panel-chevron" data-class:open={ sessionOpenExpr(sessionID) }>▸</span>
		</div>
		<div class="session-panel-body" data-class:open={ sessionOpenExpr(sessionID) }>
			<div class="session-panel-body-inner">
				if len(row.Detail.Turns) > 0 {
					<div class="log-turns">
						for i, t := range row.Detail.Turns {
							@taskTurnView(t, i+1)
						}
					</div>
				} else {
					<div class="section-empty" style="padding:12px 0;">No turns recorded for this session yet.</div>
				}
			</div>
		</div>
	</div>
}

// taskTurnView renders one turn of a dispatched session's activity as a
// straight log entry, not a chat message: nothing here was typed by a human
// at a keyboard mid-conversation - the "prompt" is the instruction the turn
// ran with (from the task, or from whatever session dispatched it), so it
// reads as a labeled log line rather than a right-aligned chat bubble.
templ taskTurnView(t sessions.TurnDetail, index int) {
	<div class="log-turn">
		<div class="log-turn-label">Turn { strconv.Itoa(index) }</div>
		<div class="log-prompt">{ t.Prompt }</div>
		for stepIdx, step := range t.Steps {
			if step.Reasoning != "" {
				@thinkingBlock(t.TurnID, stepIdx, step.Reasoning)
			}
			if step.Text != "" {
				<div class="log-text">{ step.Text }</div>
			}
			for _, tc := range step.ToolCalls {
				@toolCallView(tc)
			}
		}
		if t.Status == "running" && len(t.Steps) == 0 {
			<div class="log-text">Thinking<span class="running-cursor"></span></div>
		}
		if t.Status == "interrupted" {
			<div class="interrupted-marker">turn interrupted by a crash — some tool results may be unverified</div>
		}
	</div>
}

// thinkingBlock renders one step's reasoning text as a collapsible block.
// Its open/closed state lives in a Datastar signal (see openAttrs), not a
// native <details> element: like every other disclosure on this page, a
// plain <details open> would be reset to closed by the ambient poll's next
// patch. stepIndex disambiguates multiple steps within the same turn -
// turnID alone isn't unique enough since a turn can reason more than once.
templ thinkingBlock(turnID string, stepIndex int, reasoning string) {
	{{ id := turnID + "-" + strconv.Itoa(stepIndex) }}
	<div class="thinking-block" { openAttrs("thinking_open", id, false)... }>
		<button type="button" class="thinking-summary" data-on:click={ toggleAction("thinking_open", id) }>
			<span>Thinking</span>
			<span class="thinking-chevron" data-class:open={ openExpr("thinking_open", id) }>▸</span>
		</button>
		<div class="thinking-text-wrap" data-class:open={ openExpr("thinking_open", id) }>
			<div class="thinking-text">{ reasoning }</div>
		</div>
	</div>
}
