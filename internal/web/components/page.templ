// Package components contains the server-rendered web components.
package components

// page is the shared HTML document shell: fonts, styling, and the Datastar
// bundle. Every route renders this around its content so a direct page load
// and a Datastar-driven patch both start from the same markup. The palette is
// dark-only by design - this is a tool for watching an agent work, not a
// document meant to match the reader's system theme.
templ page(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0/bundles/datastar.js"></script>
			<style>
				:root {
					--bg: #0a0b0d;
					--surface: #101214;
					--surface-2: #16181b;
					--border: #202327;
					--text: #d9d7d2;
					--text-dim: #8b8e92;
					--text-faint: #4d5054;
					--accent: #63a89f;
					--accent-dim: #63a89f22;
					--ok: #7bab86;
					--ok-bg: #7bab861a;
					--warn: #d1a24e;
					--warn-bg: #d1a24e1a;
					--bad: #c47c5f;
					--bad-bg: #c47c5f1a;
					--neutral: #7d8085;
					--neutral-bg: #7d808530;
				}

				* { box-sizing: border-box; }

				html, body {
					margin: 0;
					padding: 0;
					height: 100%;
					background: var(--bg);
					color: var(--text);
				}

				body {
					font-family: "IBM Plex Mono", ui-monospace, "SF Mono", monospace;
					font-size: 13.5px;
					line-height: 1.6;
					display: flex;
					overflow: hidden;
				}

				::selection { background: var(--accent-dim); }

				button, .btn { font-family: "JetBrains Mono", ui-monospace, monospace; cursor: pointer; }

				a { color: inherit; text-decoration: none; }

				button:focus-visible, a:focus-visible, textarea:focus-visible, select:focus-visible {
					outline: 1px solid var(--accent);
					outline-offset: 2px;
				}

				.label {
					font-family: "JetBrains Mono", ui-monospace, monospace;
					text-transform: uppercase;
					letter-spacing: 0.08em;
					font-size: 10.5px;
					color: var(--text-faint);
				}

				.tabular { font-variant-numeric: tabular-nums; }

				.tag { font-size: 9.5px; color: var(--text-dim); background: var(--surface-2); border-radius: 3px; padding: 1px 6px; font-family: "JetBrains Mono", monospace; }

				/* ---------- tasks app ---------- */

				.tasks-app { flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

				/* .col centers one reading column at a consistent width, so
				   wide windows don't stretch content into unreadably long
				   lines. */
				.col { max-width: 900px; margin: 0 auto; box-sizing: border-box; }

				/* padding-top replaces the space the topbar used to occupy
				   (~55px, measured) now that there's no bar there - the page's
				   content starts at the same distance from the viewport top
				   as before, just without a rendered chrome element. */
				.task-list-view { flex: 1; overflow-y: auto; padding-top: 40px; }
				.task-sections { padding: 22px 28px; display: flex; flex-direction: column; gap: 26px; }
				.task-section-label { font-family: "JetBrains Mono", monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); margin-bottom: 10px; }
				.task-grid { display: flex; flex-direction: column; gap: 8px; }

				/* Each task is a card the whole time - collapsed, it's just the
				   summary button; expanded, task-card-detail continues inside
				   the SAME card (same background/border), rather than opening
				   a visually distinct panel elsewhere. Status reads from the
				   pill alone now, not a colored border. */
				.task-card {
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 6px;
					color: var(--text);
					overflow: hidden;
				}
				.task-card:hover { border-color: var(--text-faint); }

				.task-card-summary {
					display: flex;
					flex-direction: column;
					gap: 8px;
					width: 100%;
					padding: 14px 16px;
					background: none;
					border: none;
					margin: 0;
					color: inherit;
					font: inherit;
					text-align: left;
					cursor: pointer;
				}
				.task-card-top { display: flex; align-items: baseline; gap: 12px; }
				.task-card-def { flex: 1; min-width: 0; font-size: 13.5px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				.task-card-bottom { display: flex; align-items: center; gap: 10px; }
				.task-card-labels { display: flex; gap: 6px; flex-wrap: wrap; }
				.task-card-meta { margin-left: auto; flex: none; font-size: 11px; color: var(--text-faint); }
				.task-card-chevron {
					flex: none;
					color: var(--text-faint);
					font-size: 10px;
					transition: transform 0.12s ease;
				}
				.task-card-chevron.open { transform: rotate(90deg); }

				/* Expand/collapse is a max-height transition, capped generously
				   above any real content, rather than an abrupt display
				   toggle - simpler and more reliable across browsers than
				   animating an intrinsic ("auto") height. */
				.task-card-detail {
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.25s ease;
					border-top: 1px solid var(--border);
				}
				.task-card-detail.open { max-height: 3000px; }
				.task-card-detail-inner {
					display: flex;
					flex-direction: column;
					gap: 22px;
					padding: 20px 16px;
				}
				@media (prefers-reduced-motion: reduce) { .task-card-detail { transition: none; } }

				/* Details splits identity facts (Model, Commit - free-form
				   strings) from planning levels (a fixed 1-5 scale) into two
				   groups, rather than one mixed row: each reads as its own
				   kind of information instead of a run of look-alike chips. */
				.detail-cell { display: flex; flex-direction: column; gap: 5px; }
				.detail-cell .name {
					font-family: "JetBrains Mono", monospace;
					font-size: 10px;
					text-transform: uppercase;
					letter-spacing: 0.06em;
					color: var(--text-faint);
				}
				.detail-cell .val { font-size: 12.5px; color: var(--text-dim); font-family: "JetBrains Mono", monospace; }

				.detail-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; max-width: 640px; margin-bottom: 20px; }

				/* A fixed 3-column grid - unlike an auto-fill grid, 6 items
				   always fill exactly two full rows, never leaving a single
				   item stranded alone on a ragged last row. */
				.detail-levels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 28px; max-width: 640px; }

				.session-panels { display: flex; flex-direction: column; gap: 8px; }
				.session-panel {
					border: 1px solid var(--border);
					border-radius: 7px;
					background: var(--surface);
					overflow: hidden;
				}
				.session-panel-summary {
					display: flex;
					align-items: center;
					gap: 12px;
					padding: 10px 13px;
					cursor: pointer;
				}
				.session-panel-summary:hover { background: var(--surface-2); }
				.session-panel-chevron {
					flex: none;
					color: var(--text-faint);
					font-size: 10px;
					transition: transform 0.12s ease;
				}
				.session-panel-chevron.open { transform: rotate(90deg); }
				.session-panel-body {
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.2s ease;
					border-top: 1px solid var(--border);
				}
				.session-panel-body.open { max-height: 2000px; }
				.session-panel-body-inner { padding: 10px 13px; }
				@media (prefers-reduced-motion: reduce) { .session-panel-body { transition: none; } }

				/* ---------- turn log (a dispatched session's activity - not chat) ---------- */

				.log-turns { display: flex; flex-direction: column; }
				.log-turn {
					display: flex;
					flex-direction: column;
					gap: 10px;
					padding: 14px 0;
					border-top: 1px solid var(--border);
				}
				.log-turn:first-child { border-top: none; padding-top: 2px; }
				.log-turn-label {
					font-family: "JetBrains Mono", monospace;
					font-size: 10px;
					text-transform: uppercase;
					letter-spacing: 0.08em;
					color: var(--text-faint);
				}
				.log-prompt { font-size: 12.5px; font-style: italic; color: var(--text-dim); white-space: pre-wrap; line-height: 1.6; }
				.log-text { font-size: 13px; color: var(--text); white-space: pre-wrap; line-height: 1.6; }

				.status-pill {
					display: inline-flex;
					align-items: center;
					font-family: "JetBrains Mono", monospace;
					font-size: 10.5px;
					text-transform: uppercase;
					letter-spacing: 0.06em;
					padding: 3px 8px;
					border-radius: 20px;
				}
				.status-pill.running { color: var(--warn); background: var(--warn-bg); }
				.status-pill.completed { color: var(--ok); background: var(--ok-bg); }
				.status-pill.interrupted { color: var(--bad); background: var(--bad-bg); }
				.status-pill.neutral { color: var(--text-faint); background: var(--surface-2); }

				.tool-call {
					border: 1px solid var(--border);
					border-radius: 6px;
					background: var(--surface);
					margin: 4px 0;
					overflow: hidden;
				}
				.tool-call-head {
					display: flex;
					align-items: center;
					gap: 8px;
					padding: 7px 11px;
					width: 100%;
					background: none;
					border: none;
					color: var(--text-dim);
					font-family: "JetBrains Mono", monospace;
					font-size: 11.5px;
					text-align: left;
				}
				.tool-call-head:hover { color: var(--text); }
				.tool-call-chevron { color: var(--text-faint); transition: transform 0.12s ease; flex: none; font-size: 10px; }
				.tool-call-chevron.open { transform: rotate(90deg); }
				.tool-call-name { color: var(--accent); }
				.tool-call-arg { color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
				.tool-call-status { margin-left: auto; flex: none; font-size: 10px; color: var(--text-faint); }
				.tool-call-body {
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.2s ease;
					border-top: 1px solid var(--border);
				}
				.tool-call-body.open { max-height: 1600px; }
				@media (prefers-reduced-motion: reduce) { .tool-call-body { transition: none; } }
				.tool-call-body-inner { padding: 10px 11px 12px; font-size: 12px; }
				.tool-call-section-label {
					font-family: "JetBrains Mono", monospace;
					font-size: 9.5px;
					text-transform: uppercase;
					letter-spacing: 0.07em;
					color: var(--text-faint);
					margin-bottom: 5px;
				}
				.tool-call-pre {
					background: var(--surface-2);
					border-radius: 4px;
					padding: 8px 10px;
					overflow-x: auto;
					white-space: pre;
					color: var(--text-dim);
					margin: 0 0 10px;
				}
				.tool-call-pre:last-child { margin-bottom: 0; }
				.tool-call-pre.err { color: var(--bad); }

				.interrupted-marker { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--bad); padding: 6px 0; }
				.interrupted-marker::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--bad); flex: none; }

				.running-cursor {
					display: inline-block;
					width: 6px;
					height: 13px;
					background: var(--text-dim);
					vertical-align: text-bottom;
					margin-left: 2px;
					animation: blink 1s step-end infinite;
				}
				@media (prefers-reduced-motion: reduce) { .running-cursor { animation: none; opacity: 0.6; } }
				@keyframes blink { 50% { opacity: 0; } }

				.empty-state {
					flex: 1;
					display: flex;
					align-items: center;
					justify-content: center;
					color: var(--text-faint);
					font-size: 13px;
				}

				/* Left-aligned counterpart to .empty-state for a placeholder that
				   sits inside a section of content already reading left-to-right
				   (e.g. a task's session list) rather than filling an entire pane. */
				.section-empty { color: var(--text-faint); font-size: 12.5px; padding: 2px 0; }

				/* ---------- task card detail (expanded content) ---------- */

				.section-label { font-family: "JetBrains Mono", monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); margin-bottom: 10px; }
				.spec-block { font-size: 13px; color: var(--text); line-height: 1.7; }
				.labels-row { display: flex; gap: 6px; flex-wrap: wrap; }

				/* ---------- markdown (task specification) ---------- */

				.md-content { font-size: 13px; line-height: 1.7; }
				.md-content > :first-child { margin-top: 0; }
				.md-content > :last-child { margin-bottom: 0; }
				.md-content p, .md-content ul, .md-content ol, .md-content blockquote, .md-content pre, .md-content table { margin: 0 0 12px; }
				.md-content h1, .md-content h2, .md-content h3, .md-content h4 {
					font-family: "JetBrains Mono", monospace;
					font-weight: 600;
					margin: 20px 0 8px;
					line-height: 1.4;
				}
				.md-content h1 { font-size: 16px; }
				.md-content h2 { font-size: 14.5px; }
				.md-content h3, .md-content h4 { font-size: 13px; color: var(--text-dim); }
				.md-content ul, .md-content ol { padding-left: 22px; }
				.md-content li { margin-bottom: 4px; }
				.md-content a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
				.md-content code {
					font-family: "IBM Plex Mono", monospace;
					font-size: 12px;
					background: var(--surface-2);
					border-radius: 3px;
					padding: 1px 5px;
				}
				.md-content pre {
					background: var(--surface-2);
					border-radius: 6px;
					padding: 10px 12px;
					overflow-x: auto;
				}
				.md-content pre code { background: none; padding: 0; }
				.md-content blockquote {
					border-left: 2px solid var(--border);
					padding-left: 12px;
					color: var(--text-dim);
				}
				.md-content table { border-collapse: collapse; width: 100%; font-size: 12.5px; }
				.md-content th, .md-content td { border: 1px solid var(--border); padding: 6px 9px; text-align: left; }
				.md-content th { color: var(--text-dim); font-family: "JetBrains Mono", monospace; font-size: 11px; }
				.md-content hr { border: none; border-top: 1px solid var(--border); margin: 16px 0; }

				/* ---------- sessions (inline on task detail) ---------- */

				.session-row-agent {
					font-size: 9px;
					text-transform: uppercase;
					letter-spacing: 0.06em;
					color: var(--text-faint);
					border: 1px solid var(--border);
					border-radius: 3px;
					padding: 2px 6px;
					flex: none;
				}
				.session-row-meta { display: flex; gap: 10px; font-size: 10.5px; color: var(--text-faint); flex: none; }
				.session-row-tokens { margin-left: auto; flex: none; font-size: 10.5px; color: var(--text-faint); }

				/* ---------- thinking / reasoning blocks ---------- */

				.thinking-block {
					border: 1px solid var(--border);
					border-radius: 6px;
					background: var(--surface);
					margin: 4px 0;
					overflow: hidden;
				}
				.thinking-summary {
					display: flex;
					align-items: center;
					justify-content: space-between;
					width: 100%;
					padding: 7px 11px;
					background: none;
					border: none;
					font-family: "JetBrains Mono", monospace;
					font-size: 11px;
					font-style: italic;
					color: var(--text-faint);
					text-align: left;
					cursor: pointer;
				}
				.thinking-summary:hover { color: var(--text-dim); }
				.thinking-chevron { color: var(--text-faint); font-size: 9px; transition: transform 0.12s ease; }
				.thinking-chevron.open { transform: rotate(90deg); }
				.thinking-text-wrap {
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.18s ease;
					border-top: 1px solid var(--border);
				}
				.thinking-text-wrap.open { max-height: 1200px; }
				@media (prefers-reduced-motion: reduce) { .thinking-text-wrap { transition: none; } }
				.thinking-text {
					padding: 10px 11px;
					font-size: 12.5px;
					font-style: italic;
					color: var(--text-dim);
					white-space: pre-wrap;
					line-height: 1.6;
				}

				.task-list-view::-webkit-scrollbar, .task-card-detail::-webkit-scrollbar, .session-panel-body::-webkit-scrollbar { width: 8px; }
				.task-list-view::-webkit-scrollbar-thumb, .task-card-detail::-webkit-scrollbar-thumb, .session-panel-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
				.task-list-view::-webkit-scrollbar-track, .task-card-detail::-webkit-scrollbar-track, .session-panel-body::-webkit-scrollbar-track { background: transparent; }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
