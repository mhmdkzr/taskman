// Package components contains the server-rendered web components.
package components

// page is the shared HTML document shell: fonts, styling, and the Datastar
// bundle. Every route renders this around its content so a direct page load
// and a Datastar-driven patch both start from the same markup. The palette is
// dark-only by design - this is a tool for watching an agent work, not a
// document meant to match the reader's system theme.
templ page(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0/bundles/datastar.js"></script>
			<style>
				:root {
					--bg: #0a0b0d;
					--surface: #101214;
					--surface-2: #16181b;
					--border: #202327;
					--text: #e7e5e1;
					--text-dim: #8b8e92;
					--text-faint: #4d5054;
					--accent: #63a89f;
					--accent-dim: #63a89f22;
					--ok: #7bab86;
					--ok-bg: #7bab861a;
					--warn: #d1a24e;
					--warn-bg: #d1a24e1a;
					--bad: #c47c5f;
					--bad-bg: #c47c5f1a;
					--neutral: #7d8085;
					--neutral-bg: #7d808530;
				}

				* { box-sizing: border-box; }

				html, body {
					margin: 0;
					padding: 0;
					height: 100%;
					background: var(--bg);
					color: var(--text);
				}

				body {
					font-family: "IBM Plex Mono", ui-monospace, "SF Mono", monospace;
					font-size: 13.5px;
					line-height: 1.6;
					display: flex;
					overflow: hidden;
				}

				::selection { background: var(--accent-dim); }

				button, .btn { font-family: "JetBrains Mono", ui-monospace, monospace; cursor: pointer; }

				a { color: inherit; text-decoration: none; }

				button:focus-visible, a:focus-visible, textarea:focus-visible, select:focus-visible {
					outline: 1px solid var(--accent);
					outline-offset: 2px;
				}

				.label {
					font-family: "JetBrains Mono", ui-monospace, monospace;
					text-transform: uppercase;
					letter-spacing: 0.08em;
					font-size: 10.5px;
					color: var(--text-faint);
				}

				.tabular { font-variant-numeric: tabular-nums; }

				/* ---------- rail ---------- */

				.rail {
					width: 340px;
					flex: none;
					border-right: 1px solid var(--border);
					display: flex;
					flex-direction: column;
					background: var(--bg);
				}

				.rail-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: 18px 18px 14px;
					border-bottom: 1px solid var(--border);
				}

				.brand {
					font-family: "JetBrains Mono", ui-monospace, monospace;
					font-weight: 600;
					font-size: 14px;
					letter-spacing: 0.02em;
					display: flex;
					align-items: center;
					gap: 8px;
				}

				.brand-mark {
					width: 14px;
					height: 14px;
					border: 1.5px solid var(--accent);
					border-radius: 50%;
					border-top-color: transparent;
					transform: rotate(45deg);
				}

				.tabs {
					display: flex;
					gap: 2px;
					padding: 10px 14px 0;
					border-bottom: 1px solid var(--border);
				}
				.tab {
					background: none;
					border: none;
					color: var(--text-faint);
					font-family: "JetBrains Mono", monospace;
					font-size: 11.5px;
					letter-spacing: 0.03em;
					padding: 8px 10px 10px;
					border-bottom: 2px solid transparent;
				}
				.tab:hover { color: var(--text); }
				.tab.active { color: var(--text); border-bottom-color: var(--accent); }

				.rail-list {
					flex: 1;
					overflow-y: auto;
					padding: 6px 0 14px;
				}

				.session-item {
					display: flex;
					align-items: flex-start;
					gap: 9px;
					width: 100%;
					text-align: left;
					background: none;
					border: none;
					border-left: 2px solid transparent;
					color: var(--text);
					padding: 8px 18px;
				}
				.session-item.nested { padding-left: 36px; }
				.session-item:hover { background: var(--surface); }
				.session-item.active { background: var(--surface); border-left-color: var(--accent); }

				.status-dot { width: 7px; height: 7px; border-radius: 50%; margin-top: 5px; flex: none; }
				.status-dot.running { background: var(--warn); box-shadow: 0 0 0 3px var(--warn-bg); }
				.status-dot.completed { background: var(--ok); }
				.status-dot.interrupted { background: var(--bad); }
				.status-dot.neutral { background: var(--neutral); }

				.session-item-body { min-width: 0; flex: 1; }
				.session-item-top { display: flex; justify-content: space-between; gap: 8px; }
				.session-item-agent {
					font-family: "JetBrains Mono", monospace;
					font-size: 12.5px;
					font-weight: 500;
					white-space: nowrap;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.session-item-time { font-size: 10.5px; color: var(--text-faint); flex: none; }
				.session-item-preview {
					font-size: 11.5px;
					color: var(--text-dim);
					white-space: nowrap;
					overflow: hidden;
					text-overflow: ellipsis;
					margin-top: 2px;
				}
				.session-item-meta { font-size: 10px; color: var(--text-faint); margin-top: 4px; display: flex; gap: 8px; }

				/* task rows */
				.task-item {
					display: flex;
					flex-direction: column;
					gap: 6px;
					width: 100%;
					text-align: left;
					background: none;
					border: none;
					border-left: 2px solid transparent;
					color: var(--text);
					padding: 10px 18px;
				}
				.task-item:hover { background: var(--surface); }
				.task-item.active { background: var(--surface); border-left-color: var(--accent); }
				.task-item-top { display: flex; align-items: center; gap: 8px; }
				.task-item-def { font-size: 12.5px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
				.task-item-meta { display: flex; align-items: center; gap: 10px; font-size: 10px; color: var(--text-faint); }
				.task-item-labels { display: flex; gap: 5px; flex-wrap: wrap; }
				.tag { font-size: 9.5px; color: var(--text-dim); background: var(--surface-2); border-radius: 3px; padding: 1px 6px; font-family: "JetBrains Mono", monospace; }

				.rail-footer { padding: 12px 18px; border-top: 1px solid var(--border); }
				.new-session-btn {
					display: flex;
					align-items: center;
					justify-content: center;
					width: 100%;
					background: var(--surface);
					border: 1px solid var(--border);
					color: var(--text);
					padding: 8px;
					border-radius: 4px;
					font-size: 12px;
				}
				.new-session-btn:hover { border-color: var(--text-faint); }

				/* ---------- main ---------- */

				.main { flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

				.main-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: 16px 28px;
					border-bottom: 1px solid var(--border);
					flex: none;
				}
				.main-header-title { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
				.main-header-agent { font-family: "JetBrains Mono", monospace; font-weight: 600; font-size: 15px; margin: 0; }
				.main-header-id { font-size: 11px; color: var(--text-faint); }

				.status-pill {
					display: inline-flex;
					align-items: center;
					gap: 5px;
					font-family: "JetBrains Mono", monospace;
					font-size: 10.5px;
					text-transform: uppercase;
					letter-spacing: 0.06em;
					padding: 3px 8px 3px 6px;
					border-radius: 20px;
				}
				.status-pill.running { color: var(--warn); background: var(--warn-bg); }
				.status-pill.completed { color: var(--ok); background: var(--ok-bg); }
				.status-pill.interrupted { color: var(--bad); background: var(--bad-bg); }
				.status-pill.neutral { color: var(--text-faint); background: var(--surface-2); }
				.status-pill .dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
				.status-pill.running .dot { animation: pulse 1.4s ease-in-out infinite; }

				@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
				@media (prefers-reduced-motion: reduce) { .status-pill.running .dot { animation: none; } }

				.main-header-meta { display: flex; gap: 18px; align-items: center; }
				.meta-stat { text-align: right; }
				.meta-stat .label { display: block; margin-bottom: 2px; }
				.meta-stat .value { font-size: 12px; color: var(--text-dim); }

				/* ---------- transcript ---------- */

				.transcript { flex: 1; overflow-y: auto; padding: 24px 28px 12px; }
				.transcript-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
				.turn { display: flex; flex-direction: column; gap: 10px; }

				.prompt-block {
					align-self: flex-end;
					max-width: 88%;
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 8px 8px 2px 8px;
					padding: 10px 13px;
					font-size: 13px;
					white-space: pre-wrap;
					color: var(--text);
				}

				.response-block { font-size: 13.5px; white-space: pre-wrap; color: var(--text); }

				.tool-call {
					border: 1px solid var(--border);
					border-radius: 6px;
					background: var(--surface);
					margin: 4px 0;
					overflow: hidden;
				}
				.tool-call-head {
					display: flex;
					align-items: center;
					gap: 8px;
					padding: 7px 11px;
					width: 100%;
					background: none;
					border: none;
					color: var(--text-dim);
					font-family: "JetBrains Mono", monospace;
					font-size: 11.5px;
					text-align: left;
				}
				.tool-call-head:hover { color: var(--text); }
				.tool-call-chevron { color: var(--text-faint); transition: transform 0.12s ease; flex: none; font-size: 10px; }
				.tool-call.open .tool-call-chevron { transform: rotate(90deg); }
				.tool-call-name { color: var(--accent); }
				.tool-call-arg { color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
				.tool-call-status { margin-left: auto; flex: none; font-size: 10px; color: var(--text-faint); }
				.tool-call-body { display: none; border-top: 1px solid var(--border); padding: 10px 11px 12px; font-size: 12px; }
				.tool-call.open .tool-call-body { display: block; }
				.tool-call-section-label {
					font-family: "JetBrains Mono", monospace;
					font-size: 9.5px;
					text-transform: uppercase;
					letter-spacing: 0.07em;
					color: var(--text-faint);
					margin-bottom: 5px;
				}
				.tool-call-pre {
					background: var(--surface-2);
					border-radius: 4px;
					padding: 8px 10px;
					overflow-x: auto;
					white-space: pre;
					color: var(--text-dim);
					margin: 0 0 10px;
				}
				.tool-call-pre:last-child { margin-bottom: 0; }
				.tool-call-pre.err { color: var(--bad); }

				.interrupted-marker { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--bad); padding: 6px 0; }
				.interrupted-marker::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--bad); flex: none; }

				.running-cursor {
					display: inline-block;
					width: 6px;
					height: 13px;
					background: var(--text-dim);
					vertical-align: text-bottom;
					margin-left: 2px;
					animation: blink 1s step-end infinite;
				}
				@media (prefers-reduced-motion: reduce) { .running-cursor { animation: none; opacity: 0.6; } }
				@keyframes blink { 50% { opacity: 0; } }

				.ask-card {
					border: 1px solid var(--accent);
					border-radius: 8px;
					background: var(--surface);
					padding: 14px 16px;
					display: flex;
					flex-direction: column;
					gap: 12px;
					max-width: 88%;
				}
				.ask-card.answered { border-color: var(--border); }
				.ask-custom-answer {
					font-size: 12.5px;
					color: var(--text);
					background: var(--surface-2);
					border-radius: 6px;
					padding: 8px 10px;
				}
				.ask-question { font-size: 13.5px; color: var(--text); }
				.ask-options { display: flex; flex-direction: column; gap: 6px; }
				.ask-option {
					display: flex;
					flex-direction: column;
					align-items: flex-start;
					gap: 2px;
					text-align: left;
					background: var(--surface-2);
					border: 1px solid var(--border);
					border-radius: 6px;
					padding: 8px 11px;
					color: var(--text);
				}
				.ask-option:hover { border-color: var(--text-faint); }
				.ask-option.selected { border-color: var(--accent); background: var(--accent-dim); }
				.ask-option-label { font-size: 12.5px; }
				.ask-option-desc { font-size: 11px; color: var(--text-faint); }
				.ask-custom-input {
					background: var(--surface-2);
					border: 1px solid var(--border);
					border-radius: 6px;
					color: var(--text);
					font-family: "IBM Plex Mono", monospace;
					font-size: 12.5px;
					padding: 8px 10px;
					resize: none;
					line-height: 1.5;
				}
				.ask-custom-input:focus { outline: none; border-color: var(--text-faint); }
				.ask-custom-input::placeholder { color: var(--text-faint); }

				.empty-state {
					flex: 1;
					display: flex;
					align-items: center;
					justify-content: center;
					color: var(--text-faint);
					font-size: 13px;
				}

				/* ---------- task detail ---------- */

				.task-body { padding: 22px 28px; max-width: 760px; display: flex; flex-direction: column; gap: 26px; }
				.section-label { font-family: "JetBrains Mono", monospace; font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); margin-bottom: 10px; }
				.spec-block { font-size: 13px; color: var(--text); white-space: pre-wrap; line-height: 1.7; }
				.labels-row { display: flex; gap: 6px; flex-wrap: wrap; }

				.planning-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 22px; }
				.planning-stat { display: flex; flex-direction: column; gap: 6px; }
				.planning-stat-top { display: flex; justify-content: space-between; align-items: baseline; }
				.planning-stat-name { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--text-dim); }
				.planning-stat-val { font-size: 11px; color: var(--text-faint); font-family: "JetBrains Mono", monospace; }
				.meter { height: 5px; border-radius: 3px; background: var(--surface-2); overflow: hidden; }
				.meter-fill { height: 100%; background: var(--accent); border-radius: 3px; }

				.task-meta-row { display: flex; gap: 28px; flex-wrap: wrap; }
				.task-meta-item .label { margin-bottom: 3px; }
				.task-meta-item .value { font-size: 12px; color: var(--text-dim); font-family: "JetBrains Mono", monospace; }

				.sessions-list { display: flex; flex-direction: column; gap: 8px; }
				.session-row {
					display: flex; align-items: center; gap: 12px; padding: 10px 13px;
					background: var(--surface); border: 1px solid var(--border); border-radius: 7px;
				}
				.session-row:hover { border-color: var(--text-faint); }
				.session-row-role {
					font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint);
					border: 1px solid var(--border); border-radius: 3px; padding: 2px 6px; flex: none;
				}
				.session-row-agent { font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 500; flex: none; }
				.session-row-preview { font-size: 11.5px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
				.session-row-meta { display: flex; gap: 10px; font-size: 10.5px; color: var(--text-faint); flex: none; }

				/* ---------- composer ---------- */

				.composer { flex: none; border-top: 1px solid var(--border); padding: 14px 28px 18px; }
				.composer-inner { max-width: 760px; margin: 0 auto; }
				.composer-box { border: 1px solid var(--border); border-radius: 8px; background: var(--surface); padding: 10px 12px 8px; }
				.composer-textarea {
					width: 100%;
					background: none;
					border: none;
					color: var(--text);
					font-family: "IBM Plex Mono", monospace;
					font-size: 13px;
					resize: none;
					line-height: 1.5;
					field-sizing: content;
					max-height: 160px;
				}
				.composer-textarea:focus { outline: none; }
				.composer-textarea::placeholder { color: var(--text-faint); }
				.composer-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; }
				.agent-select {
					background: none;
					border: 1px solid var(--border);
					color: var(--text-dim);
					font-family: "JetBrains Mono", monospace;
					font-size: 11px;
					padding: 4px 7px;
					border-radius: 4px;
				}
				.send-btn {
					background: var(--accent);
					border: none;
					color: var(--bg);
					font-weight: 600;
					font-size: 11.5px;
					letter-spacing: 0.02em;
					padding: 6px 14px;
					border-radius: 5px;
				}
				.send-btn:hover { filter: brightness(1.08); }

				.rail-list::-webkit-scrollbar, .transcript::-webkit-scrollbar { width: 8px; }
				.rail-list::-webkit-scrollbar-thumb, .transcript::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
				.rail-list::-webkit-scrollbar-track, .transcript::-webkit-scrollbar-track { background: transparent; }
			</style>
		</head>
		<body>
			{ children... }
			<script>
				// Keeps #transcript pinned to its latest message as turns and
				// tool calls stream in via Datastar patches. Attached once to
				// document.body (which - unlike #transcript itself - is never
				// replaced by a patch) so it keeps working across every patch
				// without needing to re-run this script.
				(function () {
					function scrollToBottom() {
						var el = document.getElementById("transcript");
						if (el) el.scrollTop = el.scrollHeight;
					}
					new MutationObserver(scrollToBottom).observe(document.body, { childList: true, subtree: true });
					scrollToBottom();
				})();
			</script>
		</body>
	</html>
}
