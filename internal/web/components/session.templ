package components

import (
	"encoding/json"
	"strconv"

	"github.com/mhmdkzr/loop/internal/agent/sessions"
	"github.com/mhmdkzr/loop/internal/agent/tools/ask"
)

// sessionMain renders an active session: its header, full transcript, and -
// for a top-level session only - a composer that sends new messages into it.
// A child session (ParentSessionID set) was dispatched by another session's
// tool-call loop, not a human, so it renders read-only: messaging it directly
// would bypass whatever is actually driving it.
//
// While the latest turn is still running, the page polls itself (see the
// data-on-interval on #main-pane in App) so a pending ask - or the turn
// simply finishing - shows up without the user refreshing.
templ sessionMain(view SessionView, agentNames []string) {
	@sessionHeaderView(view.SessionDetail)
	<div class="transcript" id="transcript">
		<div class="transcript-inner">
			for _, t := range view.Turns {
				@turnView(t, view.PendingAsks[t.TurnID], view.SessionID.String())
			}
		</div>
	</div>
	if view.ParentSessionID == nil {
		@composer(view.SessionID.String(), agentNames)
	}
}

// newSessionMain renders the "+ New session" composer: no session exists yet,
// so the agent to run as is still being chosen.
templ newSessionMain(agentNames []string) {
	<div class="main-header">
		<div class="main-header-title">
			<span class="main-header-agent">New session</span>
		</div>
	</div>
	<div class="empty-state" id="transcript">Pick an agent and send a message to begin.</div>
	@newSessionComposer(agentNames)
}

templ sessionHeaderView(detail sessions.SessionDetail) {
	<div class="main-header">
		<div class="main-header-title">
			<span class="main-header-agent">{ detail.AgentName }</span>
			<span class="main-header-id">{ detail.SessionID.String() }</span>
			@statusPill(latestStatus(detail))
		</div>
		<div class="main-header-meta">
			<div class="meta-stat">
				<span class="label">Turns</span>
				<span class="value tabular">{ strconv.Itoa(len(detail.Turns)) }</span>
			</div>
			<div class="meta-stat">
				<span class="label">Started</span>
				<span class="value">{ formatTime(detail.CreatedAt) }</span>
			</div>
		</div>
	</div>
}

templ statusPill(status string) {
	<span class={ "status-pill", statusClass(status) }>
		<span class="dot"></span>
		{ statusLabel(status) }
	</span>
}

templ turnView(t sessions.TurnDetail, pending *ask.PendingAsk, sessionID string) {
	<div class="turn">
		<div class="prompt-block">{ t.Prompt }</div>
		for _, step := range t.Steps {
			if step.Text != "" {
				<div class="response-block">{ step.Text }</div>
			}
			for _, tc := range step.ToolCalls {
				if answered, ok := parseAnsweredAsk(tc); ok {
					@answeredAskView(answered)
				} else {
					@toolCallView(tc)
				}
			}
		}
		if t.Status == "running" {
			if len(t.Steps) == 0 && pending == nil {
				<div class="response-block">Thinking<span class="running-cursor"></span></div>
			}
			if pending != nil {
				@pendingAskView(*pending, sessionID)
			}
		}
		if t.Status == "interrupted" {
			<div class="interrupted-marker">turn interrupted by a crash — some tool results may be unverified</div>
		}
	</div>
}

// pendingAskView renders a still-unanswered ask.PendingAsk as an interactive
// question card: predefined options to click, a field for a custom answer,
// and a submit button that posts both to the answer endpoint. Answering
// unblocks the ask tool call polling for it server-side (see ask.execute);
// the page's own interval poll (see App) then picks up the turn's progress.
templ pendingAskView(p ask.PendingAsk, sessionID string) {
	<div class="ask-card" data-signals:ask_selected="[]" data-signals:ask_custom="''">
		<div class="ask-question">{ p.Question }</div>
		if len(p.Options) > 0 {
			<div class="ask-options">
				for _, opt := range p.Options {
					<button
						type="button"
						class="ask-option"
						data-class:selected={ askOptionSelectedExpr(opt.ID) }
						data-on:click={ askOptionClickAction(opt.ID, p.MultiSelect) }
					>
						<span class="ask-option-label">{ opt.Label }</span>
						if opt.Description != "" {
							<span class="ask-option-desc">{ opt.Description }</span>
						}
					</button>
				}
			</div>
		}
		<textarea
			class="ask-custom-input"
			data-bind:ask_custom
			rows="1"
			placeholder="Or type your own answer…"
		></textarea>
		<button
			type="button"
			class="send-btn"
			data-on:click={ answerAskAction(sessionID, p.AskID.String()) }
		>Submit ↵</button>
	</div>
}

// answeredAsk is one completed ask tool call, decoded from its stored
// input/output for display - the same question/options ask.Input carried,
// paired with the answer ask.Output recorded.
type answeredAsk struct {
	Question    string
	Options     []ask.Option
	MultiSelect bool
	Selected    map[int]bool
	Custom      string
	Error       string
}

// parseAnsweredAsk decodes tc as an ask tool call for answeredAskView. It
// returns ok=false for any other tool, or if tc's JSON doesn't parse as
// ask.Input/ask.Output (e.g. a session predating this rendering), so the
// caller falls back to the generic toolCallView rather than showing nothing.
func parseAnsweredAsk(tc sessions.ToolCallDetail) (answeredAsk, bool) {
	if tc.Name != ask.Name {
		return answeredAsk{}, false
	}
	var in ask.Input
	if err := json.Unmarshal(tc.Input, &in); err != nil {
		return answeredAsk{}, false
	}
	a := answeredAsk{
		Question: in.Question, Options: in.Options, MultiSelect: in.MultiSelect,
		Selected: make(map[int]bool), Error: tc.Error,
	}
	if tc.Output != "" {
		var out ask.Output
		if err := json.Unmarshal([]byte(tc.Output), &out); err != nil {
			return answeredAsk{}, false
		}
		for _, id := range out.Selected {
			a.Selected[id] = true
		}
		a.Custom = out.Custom
	}
	return a, true
}

// answeredAskView renders a completed ask tool call: the question, every
// option with the chosen one(s) marked, and any custom answer - the
// historical counterpart to pendingAskView, with no interactive controls.
templ answeredAskView(a answeredAsk) {
	<div class="ask-card answered">
		<div class="ask-question">{ a.Question }</div>
		if len(a.Options) > 0 {
			<div class="ask-options">
				for _, opt := range a.Options {
					<div class={ "ask-option", templ.KV("selected", a.Selected[opt.ID]) }>
						<span class="ask-option-label">{ opt.Label }</span>
						if opt.Description != "" {
							<span class="ask-option-desc">{ opt.Description }</span>
						}
					</div>
				}
			</div>
		}
		if a.Custom != "" {
			<div class="ask-custom-answer">{ a.Custom }</div>
		}
		if a.Error != "" {
			<div class="tool-call-pre err">{ a.Error }</div>
		}
	</div>
}

templ toolCallView(tc sessions.ToolCallDetail) {
	<div class="tool-call">
		<button
			class="tool-call-head"
			type="button"
			data-on:click="el.closest('.tool-call').classList.toggle('open')"
		>
			<span class="tool-call-chevron">▸</span>
			<span class="tool-call-name">{ tc.Name }</span>
			<span class="tool-call-arg">{ truncate(string(tc.Input), 80) }</span>
			<span class="tool-call-status">
				if tc.Error != "" {
					error
				} else {
					done
				}
			</span>
		</button>
		<div class="tool-call-body">
			<div class="tool-call-section-label">Input</div>
			<pre class="tool-call-pre">{ prettyJSON(tc.Input) }</pre>
			if tc.Output != "" {
				<div class="tool-call-section-label">Output</div>
				<pre class="tool-call-pre">{ prettyJSON([]byte(tc.Output)) }</pre>
			}
			if tc.Error != "" {
				<div class="tool-call-section-label">Error</div>
				<pre class="tool-call-pre err">{ tc.Error }</pre>
			}
		</div>
	</div>
}

// latestStatus is the session's overall status as its header pill shows it:
// the most recent turn's status, or "new" if it has none yet.
func latestStatus(detail sessions.SessionDetail) string {
	if len(detail.Turns) == 0 {
		return "new"
	}
	return detail.Turns[len(detail.Turns)-1].Status
}

templ composer(sessionID string, agentNames []string) {
	<div class="composer">
		<div class="composer-inner">
			<div class="composer-box">
				<textarea
					class="composer-textarea"
					data-bind:prompt
					rows="1"
					placeholder="Send a message to this session…"
					data-on:keydown={ sendKeydownAction(sessionID) }
				></textarea>
				<div class="composer-footer">
					<span class="label">continuing this session</span>
					<button
						class="send-btn"
						type="button"
						data-on:click={ sendAction(sessionID) }
					>Send ↵</button>
				</div>
			</div>
		</div>
	</div>
}

templ newSessionComposer(agentNames []string) {
	<div class="composer">
		<div class="composer-inner">
			<div class="composer-box">
				<textarea
					class="composer-textarea"
					data-bind:prompt
					rows="1"
					placeholder="Send a message to start a new session…"
					data-on:keydown={ createKeydownAction }
				></textarea>
				<div class="composer-footer">
					<select
						class="agent-select"
						data-bind:agent_name
						if len(agentNames) > 0 {
							data-signals:agent_name={ jsString(agentNames[0]) }
						}
					>
						for _, name := range agentNames {
							<option value={ name }>{ name }</option>
						}
					</select>
					<button
						class="send-btn"
						type="button"
						data-on:click={ createAction }
					>Start ↵</button>
				</div>
			</div>
		</div>
	</div>
}
