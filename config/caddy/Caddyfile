# Caddyfile for the public application and identity origins. Application
# requests use host port 8090; Zitadel requests use host port 8080. The Go app,
# Zitadel API, Login V2 service, and private webhooks are never host-published.

:80 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@webhooks path /webhooks/*
	handle @webhooks {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:8080
	}

	log {
		output stdout
	}
	encode gzip
}

# Preserve Zitadel's configured public origin while routing Login V2 to its
# dedicated internal service. All remaining identity paths go to Zitadel.
:8080 {
	@login path /ui/v2/login /ui/v2/login/*
	handle @login {
		reverse_proxy zitadel-login:3000
	}

	handle {
		reverse_proxy zitadel:8080
	}

	log {
		output stdout
	}
	encode gzip
}
