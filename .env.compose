# --- NATS ------------------------------------------------------------------------------

NATS_URL=nats://nats:4222

# --- PostgreSQL ------------------------------------------------------------------------

POSTGRES_HOST=postgres

# --- Temporal --------------------------------------------------------------------------

TEMPORAL_HOST=temporal:7233
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_POSTGRES_SEEDS=temporal-postgresql

# --- Postgres Exporter -----------------------------------------------------------------

DATA_SOURCE_NAME=postgresql://postgres:postgres@postgres:5432/postgres?sslmode=disable

# --- Temporal Auto-setup ---------------------------------------------------------------

BIND_ON_IP=0.0.0.0
DB=postgres12
POSTGRES_SEEDS=temporal-postgresql
POSTGRES_PWD=postgres
DB_PORT=5432
DYNAMIC_CONFIG_FILE_PATH=/etc/temporal/config/dynamicconfig/development-sql.yaml

# --- Zitadel ---------------------------------------------------------------------------

ZITADEL_DATABASE_POSTGRES_HOST=postgres
ZITADEL_DATABASE_POSTGRES_DATABASE=zitadel
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=postgres
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=disable
ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=postgres
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=disable
ZITADEL_DATABASE_POSTGRES_ADMIN_EXISTINGDATABASE=postgres
ZITADEL_API_URL=http://zitadel:8080
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=Password1!

# --- Zitadel Client (app) ----------------------------------------------------------------

ZITADEL_CLIENT_DOMAIN=zitadel:8080
ZITADEL_CLIENT_INSTANCE_HOST=localhost
ZITADEL_CLIENT_INSECURE=true

# --- TigerBeetle -------------------------------------------------------------------------

TIGERBEETLE_ADDRESS=172.30.0.10:3000
TIGERBEETLE_CLUSTER_ID=0

# --- RustFS (S3-compatible object storage) ---------------------------------------------

RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=app
RUSTFS_USE_PATH_STYLE=true

# --- SMTP (MailHog) ----------------------------------------------------------------------

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=App
SMTP_USERNAME=
SMTP_PASSWORD=
